rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Security Helper Functions
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ==========================================
    // Public & Catalog Collections
    // ==========================================
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /products/{id}/variants/{variantId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /postCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /coupons/{code} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /serviceablePincodes/{pincode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shippingRates/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gstRates/{hsnCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{key} {
      allow read: if key == 'business' || isAdmin();
      allow write: if isAdmin();
    }

    // ==========================================
    // Customer Account & Subcollections
    // ==========================================
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow update: if (isOwner(uid) || isAdmin()) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'stats']));
      allow create, delete: if false; // Created strictly by onUserCreate trigger
    }

    match /users/{uid}/addresses/{addressId} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/cart/{variantId} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/wishlist/{productId} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ==========================================
    // Orders & Tracking (Server-only writes)
    // ==========================================
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // Cloud Functions transaction only
    }

    match /orders/{orderId}/timeline/{eventId} {
      allow read: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid);
      allow write: if false; // Append-only by Cloud Functions
    }

    match /orders/{orderId}/notes/{noteId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // Invoices & Financial Documents (Server-only writes)
    // ==========================================
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /creditNotes/{creditNoteId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // Customer Support & CRM
    // ==========================================
    match /returns/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /tickets/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /tickets/{id}/messages/{msgId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /customerNotes/{id} {
      allow read, write: if isAdmin();
    }

    match /abandonedCarts/{id} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // ERP, Inventory, Purchasing & Admin
    // ==========================================
    match /suppliers/{id} { allow read, write: if isAdmin(); }
    match /purchaseOrders/{id} { allow read, write: if isAdmin(); }
    match /goodsReceipts/{id} { allow read: if isAdmin(); allow write: if false; }
    match /supplierBills/{id} { allow read, write: if isAdmin(); }
    match /supplierPayments/{id} { allow read: if isAdmin(); allow write: if false; }
    match /purchaseReturns/{id} { allow read, write: if isAdmin(); }
    match /expenses/{id} { allow read, write: if isAdmin(); }
    match /expenseCategories/{id} { allow read, write: if isAdmin(); }
    match /batches/{id} { allow read: if isAdmin(); allow write: if false; }
    match /stockMovements/{id} { allow read: if isAdmin(); allow write: if false; }
    match /alerts/{id} { allow read, update: if isAdmin(); allow write: if false; }
    match /dailySummaries/{id} { allow read: if isAdmin(); allow write: if false; }
    match /monthlySummaries/{id} { allow read: if isAdmin(); allow write: if false; }
    match /auditLogs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /shipments/{id} { allow read: if isAdmin(); allow write: if false; }
    match /shipmentsByAwb/{awb} { allow read, write: if false; }
    match /shipmentEvents/{id} { allow read: if isAdmin(); allow write: if false; }
    match /payments/{id} { allow read: if isAdmin(); allow write: if false; }
    match /paymentWebhookEvents/{id} { allow read, write: if false; }
    match /refunds/{id} { allow read: if isAdmin(); allow write: if false; }
    match /notifications/{id} { allow read: if isAdmin(); allow write: if false; }
    match /backupRuns/{id} { allow read: if isAdmin(); allow write: if false; }
    match /counters/{id} { allow read, write: if false; }
  }
}
