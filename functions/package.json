{
  "name": "@tea-nest/functions",
  "version": "1.0.0",
  "description": "Tea Nest Cloud Functions backend",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "cloudinary": "^2.5.1",
    "firebase-admin": "^13.0.1",
    "firebase-functions": "^6.3.0",
    "pdfkit": "^0.15.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pdfkit": "^0.13.9",
    "typescript": "^5.7.2"
  },
  "private": true
}
